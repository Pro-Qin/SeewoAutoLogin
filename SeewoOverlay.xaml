<Window x:Class="SeewoAutoLogin.SeewoOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SeewoOverlay"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" Topmost="False" ShowActivated="False"
    UseLayoutRounding="True"
    Width="400" Height="400" IsHitTestVisible="True"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    Closed="OnClosedHandler">
    <Grid>
        <Border x:Name="OverlayPanel" 
                Background="#CC1C1C1E" CornerRadius="14"
                Width="200" HorizontalAlignment="Left"
                Padding="14,20" IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center">
                <Button Content="✕" FontSize="16" Foreground="White" 
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Right"
                        Padding="4,2" Margin="0,-10,0,10"
                        Click="CloseButton_Click"/>
                <TextBlock Text="未加入希沃列表" FontSize="13" FontWeight="600" 
                           Foreground="White" Margin="0,0,0,14"
                           HorizontalAlignment="Center"/>
                <ItemsControl x:Name="AccountList" IsHitTestVisible="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2C2C2E" CornerRadius="10" 
                                    Padding="10,8" Margin="0,0,0,6"
                                    Cursor="Hand" IsHitTestVisible="True"
                                    BorderBrush="#3A3A3A" BorderThickness="1"
                                    MouseLeftButtonDown="AccountItem_Click">
                                <StackPanel>
                                    <TextBlock Text="{Binding MaskedContact}" FontSize="10" 
                                               Foreground="#aaa" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" 
                                               FontWeight="500" Foreground="White"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>