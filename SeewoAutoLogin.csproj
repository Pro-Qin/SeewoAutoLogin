<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- net48 默认语言版本是 C# 7.3；这里锁定到代码实际需要的最高版本（init/record 要 9，record struct 要 10），
         避免 SDK 升级后语言版本静默漂移、引入 net48 补不出 polyfill 的新语法（如 required）。
         相关 polyfill：Services/IsExternalInit.cs -->
    <LangVersion>10.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 必须与 main 分支同架构：WebView2Loader.dll 是原生 DLL，AnyCPU 会拷错架构导致运行时加载失败 -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>SeewoAutoLogin</AssemblyName>
    <RootNamespace>SeewoAutoLogin</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.14.11</Version>
    <Company>SeewoAutoLogin</Company>
    <Description>SeewoAutoLogin - 希沃自动登录（Windows 7 兼容分支）</Description>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <!-- .NET Framework 下这些程序集不在 SDK 默认引用集里，必须显式引用（Win7 分支用 net48） -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- ProtectedData / DPAPI -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <!-- 这个版本不能升：WebView2 SDK 1.0.1519.0 起不再支持 Windows 7 / 8.1（运行时同样以 109 为上限）。
         出处：https://blogs.windows.com/msedgedev/2022/12/09/microsoft-edge-and-webview2-ending-support-for-windows-7-and-windows-8-8-1/ -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1462.37" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="frontend\**\*" />
    <EmbeddedResource Include="Resources\app.ico" />
    <EmbeddedResource Include="Resources\terms.txt" />
  </ItemGroup>

  <!-- 测试工程单独编译，不进入主程序 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

</Project>