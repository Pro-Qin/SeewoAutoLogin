<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SeewoAutoLogin</AssemblyName>
    <RootNamespace>SeewoAutoLogin</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.12.10</Version>
    <Company>SeewoAutoLogin</Company>
    <Description>希沃自动登录 - 独立版</Description>

    <!-- 单文件发布配置 -->
    <PublishSingleFile Condition="'$(Configuration)'=='Release'">true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)'=='Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="frontend\**\*" />
    <EmbeddedResource Include="Resources\app.ico" />
    <!-- 用户协议正文：欢迎界面与「关于」页共用同一份，避免两处内容不一致 -->
    <EmbeddedResource Include="Resources\terms.txt" />
  </ItemGroup>

</Project>
