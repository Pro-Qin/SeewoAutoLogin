<Window x:Class="SeewoAutoLogin.TextInputDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="输入" Width="380" Height="190"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize" Background="{StaticResource ContentBg}"
    TextElement.Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" x:Name="PromptText" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <TextBox Grid.Row="1" x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="False"
                 VerticalContentAlignment="Center" Padding="8" FontSize="14"/>
        <PasswordBox Grid.Row="1" x:Name="PasswordBox" Padding="8" FontSize="14"
                 VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Padding="20,8" Click="Ok_Click" Style="{StaticResource AccentButtonStyle}" IsDefault="True"/>
            <Button Content="取消" Padding="16,8" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
