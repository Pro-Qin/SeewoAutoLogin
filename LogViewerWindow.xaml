<Window x:Class="SeewoAutoLogin.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="诊断日志" Width="720" Height="500"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource ContentBg}"
    TextElement.Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="诊断日志" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshLogBtn" Content="刷新" Margin="12,0,0,0" Padding="14,6"
                    Click="RefreshLog_Click" Style="{StaticResource SmallButtonStyle}"/>
            <Button x:Name="ClearLogBtn" Content="清空日志" Margin="8,0,0,0" Padding="14,6"
                    Click="ClearLog_Click" Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="6" Padding="10">
            <ScrollViewer>
                <TextBlock x:Name="LogContent" FontFamily="Consolas" FontSize="13"
                           Foreground="#D4D4D4" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="LogStatus" Grid.Row="2" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
    </Grid>
</Window>
