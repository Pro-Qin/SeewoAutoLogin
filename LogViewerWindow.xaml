<Window x:Class="SeewoAutoLogin.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="诊断日志" Width="980" Height="640" MinWidth="760" MinHeight="440"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource ContentBg}"
    TextElement.Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 日志行自绘：默认 ListBoxItem 选中会铺一层系统蓝，和深色面板冲突 -->
        <Style x:Key="LogItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2A2D3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="诊断日志" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="RefreshLogBtn" Content="刷新" Margin="12,0,0,0" Padding="14,6"
                    Click="RefreshLog_Click" Style="{StaticResource SmallButtonStyle}"/>
            <CheckBox x:Name="AutoRefreshCheck" Content="自动刷新" Margin="10,0,0,0"
                      Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
            <Button x:Name="ExportLogBtn" Content="导出日志" Margin="10,0,0,0" Padding="14,6"
                    Click="ExportLog_Click" Style="{StaticResource SmallButtonStyle}"/>
            <Button x:Name="ClearLogBtn" Content="清空日志" Margin="8,0,0,0" Padding="14,6"
                    Click="ClearLog_Click" Style="{StaticResource SmallButtonStyle}"/>
            <Button x:Name="CloseBtn" Content="关闭" Margin="8,0,0,0" Padding="14,6"
                    Click="Close_Click" Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="日期" Style="{StaticResource FilterLabel}"/>
            <ComboBox x:Name="DateCombo" Width="150" Style="{StaticResource FilterCombo}"
                      SelectionChanged="DateCombo_SelectionChanged"/>
            <TextBlock Text="等级" Style="{StaticResource FilterLabel}" Margin="12,0,6,0"/>
            <ComboBox x:Name="LevelCombo" Width="130" Style="{StaticResource FilterCombo}"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="全部等级"/>
                <ComboBoxItem Content="问题（警告+错误）"/>
                <ComboBoxItem Content="只看错误"/>
                <ComboBoxItem Content="只看警告"/>
                <ComboBoxItem Content="只看信息"/>
                <ComboBoxItem Content="只看调试"/>
            </ComboBox>
            <TextBlock Text="模块" Style="{StaticResource FilterLabel}" Margin="12,0,6,0"/>
            <ComboBox x:Name="ModuleCombo" Width="150" Style="{StaticResource FilterCombo}"
                      SelectionChanged="Filter_Changed"/>
            <TextBlock Text="行数" Style="{StaticResource FilterLabel}" Margin="12,0,6,0"/>
            <ComboBox x:Name="RowLimitCombo" Width="100" Style="{StaticResource FilterCombo}"
                      SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="200 行"/>
                <ComboBoxItem Content="500 行"/>
                <ComboBoxItem Content="1000 行"/>
                <ComboBoxItem Content="2000 行"/>
                <ComboBoxItem Content="5000 行"/>
                <ComboBoxItem Content="全部"/>
            </ComboBox>
            <TextBlock Text="搜索" Style="{StaticResource FilterLabel}" Margin="12,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="180" Style="{StaticResource FilterBox}"
                     TextChanged="SearchBox_TextChanged"/>
        </WrapPanel>

        <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="6" Padding="8">
            <ListBox x:Name="LogList"
                     Background="Transparent" BorderThickness="0" Foreground="#D4D4D4"
                     SelectionMode="Extended"
                     ItemContainerStyle="{StaticResource LogItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="复制选中行" Click="CopySelected_Click"/>
                        <MenuItem Header="复制显示的全部行" Click="CopyVisible_Click"/>
                        <Separator/>
                        <MenuItem Header="打开日志文件夹" Click="OpenLogFolder_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#6E7681"/>
                            <Run Text="{Binding LevelText, Mode=OneWay}" Foreground="{Binding LevelBrush, Mode=OneWay}"/>
                            <Run Text="{Binding ModuleText, Mode=OneWay}" Foreground="#4EC9B0"/>
                            <Run Text="{Binding BodyText, Mode=OneWay}" Foreground="{Binding BodyBrush, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="LogStatus" Grid.Row="3" FontSize="12" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
</Window>
