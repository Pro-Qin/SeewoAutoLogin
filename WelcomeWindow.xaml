<Window x:Class="SeewoAutoLogin.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SeewoAutoLogin"
    Title="欢迎使用希沃自动登录"
    Width="580" Height="520"
    MinWidth="520" MinHeight="460"
    WindowStartupLocation="CenterScreen"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource ContentBg}"
    TextElement.Foreground="{StaticResource PrimaryTextBrush}"
    WindowStyle="SingleBorderWindow"
    Closing="Window_Closing">

    <Window.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="14,0"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Background" Value="#E8F4FD"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======== HEADER ======== -->
        <Border Grid.Row="0" Padding="32,24,32,16"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- SVG: Shield icon -->
                <Viewbox Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <Canvas Width="24" Height="24">
                        <Path Fill="{StaticResource AccentBrush}"
                              Data="M12,1L3,5v6c0,5.55 3.84,10.74 9,12c5.16,-1.26 9,-6.45 9,-12V5L12,1z M12,11.99h7c-0.53,4.12 -3.28,7.79 -7,8.94V12H5V6.3l7,-3.11V11.99z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="欢迎使用希沃自动登录" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Seewo Auto Login — 为希沃白板提供快捷 SSO 登录服务"
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <!-- ======== CONTENT ======== -->
        <Grid Grid.Row="1" Margin="32,20,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab Navigation -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <RadioButton x:Name="TabAgreement" Content="用户协议" IsChecked="True"
                             Style="{StaticResource TabButtonStyle}"
                             Checked="Tab_Changed" Tag="agreement"/>
                <RadioButton x:Name="TabCredits" Content="致谢" Margin="8,0,0,0"
                             Style="{StaticResource TabButtonStyle}"
                             Checked="Tab_Changed" Tag="credits"/>
                <RadioButton x:Name="TabGuide" Content="快速上手" Margin="8,0,0,0"
                             Style="{StaticResource TabButtonStyle}"
                             Checked="Tab_Changed" Tag="guide"/>
            </StackPanel>

            <!-- Tab Content -->
            <Border Grid.Row="1" Padding="20" CornerRadius="8"
                    Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <!-- Page 1: User Agreement -->
                    <ScrollViewer x:Name="AgreementPage" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="用户协议" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                            <TextBlock TextWrapping="Wrap" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" LineHeight="20">
                                <Run Text="1. 软件说明" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <LineBreak/>
                                本软件（"希沃自动登录"）是一款独立的桌面工具，旨在为希沃白板提供账号管理及 SSO 快捷登录能力。软件通过本地 HTTP 网关拦截希沃白板的登录请求，并注入已保存的账号凭据以实现自动登录。
                                <LineBreak/><LineBreak/>

                                <Run Text="2. 账号信息与安全" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <LineBreak/>
                                本软件仅在本地存储您的账号信息。密码登录凭据以明文保存在本地配置文件中；二维码登录令牌使用 Windows DPAPI 加密后存储于当前用户目录下。请仅在可信设备上使用本软件，并妥善保管您的配置文件。
                                <LineBreak/><LineBreak/>

                                <Run Text="3. 免责声明" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <LineBreak/>
                                本软件按"现状"提供，不提供任何明示或暗示的保证。开发者不对因使用本软件而导致的任何账号信息泄露、密码泄露、账号被盗或其他数据损失承担责任。使用者应自行评估风险并采取适当的安全措施，包括但不限于使用强密码、定期更换密码以及在共享设备上谨慎使用本软件。
                                <LineBreak/><LineBreak/>

                                <Run Text="4. 网络请求" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <LineBreak/>
                                本软件在进行密码登录时会向希沃教育平台（edu.seewo.com）发送加密后的密码凭据。二维码登录时会连接希沃账号中心（id.seewo.com）获取二维码会话及校验登录状态。所有网络请求均与希沃官方移动端使用的协议一致。
                                <LineBreak/><LineBreak/>

                                <Run Text="5. 知识产权" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <LineBreak/>
                                本软件基于 InkCanvas 社区插件的原始代码提取和重构，遵循其原有开源许可条款。除第三方组件外，本软件代码及相关资源的知识产权归贡献者所有。
                                <LineBreak/><LineBreak/>

                                <Run Text="6. 协议变更" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <LineBreak/>
                                开发者保留随时修改本协议的权利。重大变更将通过软件更新通知。继续使用本软件即表示您接受修改后的协议。
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Page 2: Credits -->
                    <ScrollViewer x:Name="CreditsPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="灵感来源与致谢" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                            <Border Padding="16" CornerRadius="8" Margin="0,0,0,16"
                                    Background="#F0F7FF"
                                    BorderBrush="#CCE5FF" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <!-- SVG: Link/External icon -->
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{StaticResource AccentBrush}"
                                                      Data="M19,19H5V5h7V3H5C3.89,3 3,3.89 3,5v14c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2v-7h-2V19z M14,3v2h3.59l-9.83,9.83l1.41,1.41L19,6.41V10h2V3H14z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Text="原项目仓库" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}">
                                        本软件源自
                                        <Hyperlink NavigateUri="https://github.com/CJKmkp/SeewoAutoLogin"
                                                   RequestNavigate="Hyperlink_RequestNavigate">
                                            InkCanvas 插件 SeewoAutoLogin
                                        </Hyperlink>
                                        ，由 CJKmkp 开发。本项目将其从 InkCanvas 插件框架中提取并重构为独立的桌面应用程序。
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock TextWrapping="Wrap" FontSize="13"
                                       Foreground="{StaticResource TextSecondary}" LineHeight="20"
                                       Margin="0,0,0,12">
                                感谢原作者 CJKmkp 开发了原始的希沃自动登录插件，为本独立版的实现提供了核心逻辑基础。本软件保留了原插件的全部功能，并在此基础上增加了系统托盘后台运行、开机自启等独立应用特性。
                            </TextBlock>

                            <Separator Margin="0,8,0,12"/>

                            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondary}">
                                <Run Text="技术栈：" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                C# / .NET 8 / WPF / Windows DPAPI
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Page 3: Quick Start Guide -->
                    <ScrollViewer x:Name="GuidePage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="快速上手" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                            <!-- Step 1 -->
                            <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                    Background="#FAFAFA"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="1" Foreground="White" FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="添加账号" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}" Margin="34,0,0,0">
                                        在"添加账号"页面输入您的希沃账号信息。支持两种方式：
                                        <LineBreak/>
                                        • 密码登录 — 输入手机号/用户名和密码直接登录
                                        <LineBreak/>
                                        • 官方扫码 — 使用希沃官方移动端扫描二维码登录（更安全）
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Step 2 -->
                            <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                    Background="#FAFAFA"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="2" Foreground="White" FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="SSO 网关自动运行" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}" Margin="34,0,0,0">
                                        添加账号后，应用会在后台自动启动 SSO 网关（端口 24300）。打开希沃白板，它将自动通过此网关登录，无需手动输入密码。
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Step 3 -->
                            <Border Padding="14" CornerRadius="8" Margin="0,0,0,12"
                                    Background="#FAFAFA"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="3" Foreground="White" FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="后台运行与管理" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}" Margin="34,0,0,0">
                                        关闭窗口后应用将最小化到系统托盘。您可以在设置中启用开机自启，让 SSO 网关始终在后台运行。双击托盘图标可重新打开管理窗口。
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ======== FOOTER ======== -->
        <Border Grid.Row="2" Padding="32,16,32,20"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <CheckBox x:Name="AgreeCheckBox" Margin="0,0,0,12" FontSize="13"
                          Foreground="{StaticResource TextPrimary}"
                          Checked="Agree_Changed" Unchecked="Agree_Changed">
                    <TextBlock>
                        我已阅读并同意<Run Text="用户协议" FontWeight="SemiBold"/>（含免责声明）
                    </TextBlock>
                </CheckBox>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartButton"
                            Content="开始使用"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="StartButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
